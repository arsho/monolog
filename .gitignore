# ==============================================================================
# Build artifacts
# ==============================================================================
*.out
*.o
*.obj
*.so
*.a
*.exe
build/
cmake-build-*/

# ==============================================================================
# Benchmark run artifacts
# ------------------------------------------------------------------------------
# Result relations can be many GB (a billion-pair closure is ~17 GB) and are
# never committed. Per-benchmark results/*.csv and results/charts/ ARE tracked
# (the benchmark READMEs render them); the frozen copies behind the published
# numbers live in results/paper/ and are never overwritten by a re-run.
# ==============================================================================
*_tc.bin
*_sg.bin
*_cc.bin
*/results/*.bin
*/tests/*.dump
*/tests/*.tmp

# Profiler output
*.ncu-rep
*.nsys-rep
*.qdrep
*.sqlite
cufile.log
core.*

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
ENV/
virtualenv/
.python-version
.conda/
conda-meta/

